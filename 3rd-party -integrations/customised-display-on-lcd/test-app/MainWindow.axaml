<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CusProtocolTester.MainWindow"
        Title="CUS USB CDC tester"
        Width="580"
        Height="920"
        MinWidth="480"
        MinHeight="520">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Two draw modes: Grid (setup + update by id) and Absolute (x/y/w/h stack; clear_canvas to refresh). See host_usb_cdc_customised.md." />

    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" BorderThickness="1"
            BorderBrush="{DynamicResource SystemAccentColor}" CornerRadius="4">
      <ScrollViewer MaxHeight="120">
        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="100" />
      </ScrollViewer>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
      <CheckBox x:Name="ShowJsonPreviewCheck" Content="Show JSON preview" />
      <TextBox x:Name="JsonPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="80" MaxHeight="160" FontFamily="Consolas, monospace"
               IsVisible="False" />
    </StackPanel>

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
        <TextBlock Text="Serial" FontWeight="Bold" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Port" />
          <DockPanel Grid.Row="0" Grid.Column="1">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" x:Name="RefreshPortsBtn" Content="Refresh" />
            <ComboBox x:Name="PortCombo" />
          </DockPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Baud" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="BaudBox" Text="115200" />
          <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Status" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ConnectionStatusText"
                     VerticalAlignment="Center" FontWeight="SemiBold"
                     Text="Not connected" Foreground="#C62828" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenBtn" Content="Open" MinWidth="80" />
            <Button x:Name="CloseBtn" Content="Close" MinWidth="80" IsEnabled="False" />
            <Button x:Name="SendStopBtn" Content="Send Stop" MinWidth="100" IsEnabled="False" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <TabControl x:Name="ModeTabs">
        <!-- ========== GRID ========== -->
        <TabItem Header="Grid mode">
          <ScrollViewer>
            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock TextWrapping="Wrap" Opacity="0.85"
                         Text="layout:grid — WPF-like rows/cols. Setup once, then update widgets by id (no clear_canvas)." />

              <TextBlock Text="Step 1 — Setup grid" FontWeight="Bold" FontSize="15" />
              <TextBlock TextWrapping="Wrap" Opacity="0.85"
                         Text="Define rows/cols and widgets (default 3×4 with marquee middle row)." />
              <CheckBox x:Name="GridFullscreenCheck" Content="fullscreen on grid setup" IsChecked="True" />
              <Button x:Name="SendGridSetupBtn" Content="Send grid setup (3×4 default)"
                      HorizontalAlignment="Left" MinWidth="220" IsEnabled="False" />

              <Separator Margin="0,8" />

              <TextBlock Text="Step 2 — Update content" FontWeight="Bold" FontSize="15" />
              <TextBlock TextWrapping="Wrap" Opacity="0.85"
                         Text="Change text/image on an existing widget by id. Does not rebuild the grid." />
              <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="set id" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="GridSetIdBox" Text="4" />
                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0" Text="text_op" />
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="GridTextOpCombo" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="text" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GridSetTextBox"
                         Watermark="text for set[]" />
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="fg" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="GridSetFgBox" Watermark="optional #RRGGBB" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock VerticalAlignment="Center" Text="Symbol" />
                <ComboBox x:Name="SymbolComboGrid" Width="140" />
                <Button x:Name="InsertSymbolGridBtn" Content="Insert into text" />
              </StackPanel>
              <Button x:Name="SendGridSetBtn" Content="Send grid set (update by id)"
                      HorizontalAlignment="Left" MinWidth="220" IsEnabled="False" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== ABSOLUTE ========== -->
        <TabItem Header="Absolute mode">
          <ScrollViewer>
            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock TextWrapping="Wrap" Opacity="0.85"
                         Text="Pixel x/y/w/h stacking. No stable ids — refresh with clear_canvas then redraw." />

              <TextBlock Text="Geometry" FontWeight="Bold" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="x" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="XBox" Text="0" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="y" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="YBox" Text="0" />
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="w" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="WBox" Text="480" />
                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="h" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="HBox" Text="200" />
              </Grid>

              <TextBlock Text="text" />
              <TextBox x:Name="MessageTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                       Watermark="UTF-8 label text" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock VerticalAlignment="Center" Text="Symbol" />
                <ComboBox x:Name="SymbolComboAbs" Width="140" />
                <Button x:Name="InsertSymbolAbsBtn" Content="Insert into text" />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="fg" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FgBox" Text="#FFFFFF" Watermark="#RRGGBB" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="bg" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="BgBox" Text="#224466" Watermark="#RRGGBB" />
              </Grid>

              <TextBlock Text="align" />
              <ComboBox x:Name="AlignCombo" />
              <TextBlock Text="long_mode" />
              <ComboBox x:Name="LongModeCombo" />
              <TextBlock Text="cmd" />
              <ComboBox x:Name="CmdCombo" />

              <CheckBox x:Name="ClearCanvasCheck" Content="clear_canvas (erase all stacked overlays)" />
              <CheckBox x:Name="ActivateCheck" Content="activate (legacy when cmd omitted)" IsChecked="True" />
              <CheckBox x:Name="FullscreenCheck" Content="fullscreen (480×320 canvas, hide key strip)" />

              <TextBlock Text="image (PNG basename on MSC customised/)" />
              <TextBox x:Name="ImageBox" Watermark="e.g. bg.png (copy file to USB first)" />

              <TextBlock Text="leds (per-key RGB)" FontWeight="Bold" />
              <CheckBox x:Name="LedsIncludeCheck" Content="include leds object in payload" />
              <CheckBox x:Name="LedsOnCheck" Content="leds.on" IsChecked="True" />
              <TextBlock Text="keys 0..7 (#RRGGBB; empty = omit / leave unchanged)" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" x:Name="Led0Box" Watermark="key0" Text="#FF0000" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="4,0,0,4" x:Name="Led1Box" Watermark="key1" Text="#00FF00" />
                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,4,4" x:Name="Led2Box" Watermark="key2" Text="#0000FF" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="4,0,0,4" x:Name="Led3Box" Watermark="key3" Text="#FFFFFF" />
                <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,4,4" x:Name="Led4Box" Watermark="key4" Text="#FFAA00" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="4,0,0,4" x:Name="Led5Box" Watermark="key5" Text="#00FFFF" />
                <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,4,4" x:Name="Led6Box" Watermark="key6" Text="#FF00FF" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="4,0,0,4" x:Name="Led7Box" Watermark="key7" Text="#000000" />
              </Grid>

              <TextBlock Text="border (panel outline)" FontWeight="Bold" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="mode" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="BorderModeCombo" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="width (px)" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="BorderWidthBox" Text="2" Watermark="when mode = number" />
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="border-color" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="BorderColorBox" Watermark="#RRGGBB (optional if border on)" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="border-radius" />
                <TextBox Grid.Column="1" x:Name="BorderRadiusBox" Watermark="px; leave empty to omit key" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshPreviewBtn" Content="Refresh preview" MinWidth="120" />
                <Button x:Name="SendBtn" Content="Send framed message" MinWidth="160" IsEnabled="False" />
                <Button x:Name="SendStartBtn" Content="Send Start" MinWidth="100" IsEnabled="False" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== RAW ========== -->
        <TabItem Header="Raw JSON">
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Opacity="0.85"
                       Text="Send any cus JSON payload with the same framing (cus + BE u16 + UTF-8)." />
            <TextBox x:Name="RawJsonBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200"
                     Watermark="e.g. {&quot;text&quot;:&quot;Hello&quot;,&quot;activate&quot;:true}"
                     FontFamily="Consolas, monospace" />
            <Button x:Name="SendRawBtn" Content="Send raw JSON (same framing)" HorizontalAlignment="Left"
                    IsEnabled="False" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</Window>
